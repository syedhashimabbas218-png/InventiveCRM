# Settings for ops/*.sh. Copy to ops.env. Not passed to the containers.
BACKUP_DIR=/var/backups/inventivecrm
BACKUP_RETENTION_DAYS=30
# Run after every backup with BACKUP_PATH set, e.g. to copy it to another provider. Keep at least one copy off this server.
# BACKUP_OFFSITE_COMMAND=restic -r s3:https://s3.example.com/inventivecrm-backups backup "$BACKUP_PATH"
BACKUP_OFFSITE_COMMAND=
# API keys of our own canary workspaces (one *.key file each), read by the smoke test after upgrades and restores.
SMOKE_KEYS_DIR=/etc/inventivecrm/smoke-keys
UPGRADE_TIMEOUT=1200

# Weekly update check (ops/auto-update.sh): builds and rehearses a new Twenty release, never upgrades production.
# The checkout, the build and the stage logs live here; the build is capped at this much memory.
UPDATE_WORK_DIR=/var/lib/inventivecrm-update
UPDATE_BUILD_MEMORY=6g
# The throwaway test stack the app suites run against and the keys of its test workspaces (tests/run-all.sh).
# Left empty, our apps are not tried on a new release and it is never reported ready.
TEST_STACK_DIR=
TEST_KEYS_DIR=
TEST_SERVER_URL=http://localhost:3001
# Folder of the node the suites need, when that is not the default one.
TEST_NODE_DIR=
# Passed on to the suites: set to off when the test stack has no routing server.
# ROAD_ROUTING=off

# Health check (ops/health-check.sh, every 15 minutes; deploy/MONITORING.md). The values shown are the defaults.
HEALTH_BACKUP_MAX_AGE_HOURS=26
HEALTH_DRILL_MAX_AGE_DAYS=35
HEALTH_DISK_WARN_PERCENT=80
HEALTH_DISK_FAIL_PERCENT=90
# Failed jobs and errors in the worker log since the previous check: one is a WARN, this many a FAIL.
HEALTH_WORKER_ERRORS_FAIL=10
HEALTH_TLS_WARN_DAYS=21
HEALTH_TLS_FAIL_DAYS=7
# Names checked on 127.0.0.1:443. Empty: the site names in caddy/Caddyfile, a wildcard through its app subdomain.
HEALTH_TLS_HOSTS=
# off: do not report a rehearsed release waiting to be applied.
HEALTH_RELEASE_CHECK=on
# Alerts go out only when the set of failing checks changes. Each channel is optional.
# This file is public: put the real address in ops.env only.
ALERT_EMAIL=
# Email goes through the stack's mail relay, or sendmail. Set this to submit to another server instead.
# ALERT_SMTP_URL=smtp://127.0.0.1:25
# POSTed as JSON (title, text, content, status, failing, host, checkedAt). MONITORING.md lists URLs for ntfy, Slack,
# Discord and healthchecks.io.
ALERT_WEBHOOK_URL=
# Fetched after every run without a FAIL (healthchecks.io, Uptime Kuma push); its silence is the alert.
HEARTBEAT_URL=
