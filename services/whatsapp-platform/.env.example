# Owner role: runs migrations, needs BYPASSRLS. Never used by the running service.
DATABASE_OWNER_URL=postgres://wa_owner:change-me@localhost:5432/whatsapp
# Application role: subject to row-level security.
DATABASE_URL=postgres://wa_app:change-me@localhost:5432/whatsapp
# 32-byte base64 key for per-client token encryption. Keep it outside the database (secret manager / KMS).
TOKEN_ENCRYPTION_KEY_ID=k1
TOKEN_ENCRYPTION_KEY=
