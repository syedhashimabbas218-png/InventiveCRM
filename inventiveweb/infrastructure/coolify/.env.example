# Coolify runtime settings. Never commit populated credentials.
# Use the digest produced by the branded image build, not twentycrm/twenty.
INVENTIVEWEB_IMAGE=ghcr.io/YOUR_ORG/inventiveweb-twenty@sha256:REPLACE
PUBLIC_APP_URL=https://workspace.YOUR_DOMAIN
PG_PASSWORD=
REDIS_PASSWORD=
# Generate 32 random bytes encoded as 64 hex characters; keep stable across deploys.
ENCRYPTION_KEY=
APP_SECRET=
EMAIL_FROM_ADDRESS=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
# Keep single-workspace for the initial operator-only staging verification.
IS_MULTIWORKSPACE_ENABLED=false
DEFAULT_SUBDOMAIN=app
CALENDAR_PROVIDER_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
CALENDAR_PROVIDER_MICROSOFT_ENABLED=false
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
