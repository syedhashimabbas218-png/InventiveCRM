# Settings for ops/*.sh. Copy to ops.env. Not passed to the containers.
BACKUP_DIR=/var/backups/inventivecrm
BACKUP_RETENTION_DAYS=30
# Run after every backup with BACKUP_PATH set, e.g. to copy it to another provider. Keep at least one copy off this server.
# BACKUP_OFFSITE_COMMAND=restic -r s3:https://s3.example.com/inventivecrm-backups backup "$BACKUP_PATH"
BACKUP_OFFSITE_COMMAND=
# API keys of our own canary workspaces (one *.key file each), read by the smoke test after upgrades and restores.
SMOKE_KEYS_DIR=/etc/inventivecrm/smoke-keys
UPGRADE_TIMEOUT=1200
