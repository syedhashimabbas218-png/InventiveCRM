# Image built by .github/workflows/rebrand.yml. Pin a tag; never use latest.
IMAGE=ghcr.io/syedhashimabbas218-png/platform-twenty:2.55.0-p1

# Multi-tenant: one workspace per client at <subdomain>.crm.inventiveweb.studio.
# Needs DNS for crm.inventiveweb.studio and *.crm.inventiveweb.studio, and a TLS proxy in front of port 3000.
SERVER_URL=https://crm.inventiveweb.studio
IS_MULTIWORKSPACE_ENABLED=true
DEFAULT_SUBDOMAIN=app
# The first account created on a fresh instance becomes server admin; only server admins can then create workspaces.
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=true

# openssl rand -base64 32. Set once and never change it (see the upgrade guide).
ENCRYPTION_KEY=

# openssl rand -hex 32
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=
PG_DATABASE_NAME=default

# Runs app logic functions (quotes, invoices, PDFs) inside the server and worker. Off by default in production.
LOGIC_FUNCTION_TYPE=LOCAL

STORAGE_TYPE=local
IS_BILLING_ENABLED=false

EMAIL_DRIVER=SMTP
EMAIL_FROM_NAME=InventiveCRM
EMAIL_FROM_ADDRESS=noreply@inventiveweb.studio
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
