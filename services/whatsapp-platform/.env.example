# Owner role: runs migrations, needs BYPASSRLS. Never used by the running service.
DATABASE_OWNER_URL=postgres://wa_owner:change-me@localhost:5432/whatsapp
# Application role: subject to row-level security.
DATABASE_URL=postgres://wa_app:change-me@localhost:5432/whatsapp
# 32-byte base64 key for per-client token encryption. Keep it outside the database (secret manager / KMS).
TOKEN_ENCRYPTION_KEY_ID=k1
TOKEN_ENCRYPTION_KEY=
# Meta app secret (webhook signatures) and the verify token you set in the App Dashboard.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Point at the mock (npm run mock-whatsapp) in development. Never at production with real tokens from here.
GRAPH_API_BASE_URL=http://127.0.0.1:4010
GRAPH_API_VERSION=v26.0
# MCP: browser origins allowed to call /mcp/:tenantId (server-to-server clients send no Origin).
MCP_ALLOWED_ORIGINS=
# Development only: lets event subscriptions use http:// and local addresses.
ALLOW_INSECURE_SUBSCRIPTION_URLS=false
